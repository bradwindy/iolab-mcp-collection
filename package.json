{
  "name": "nz-mcp-collection",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "A collection of remote MCP servers exposing New Zealand public APIs, clustered by research domain and hosted on Cloudflare Workers.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "dev:portal": "pnpm --filter @nz-mcp/portal run dev",
    "deploy:all": "pnpm -r --if-present run deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
