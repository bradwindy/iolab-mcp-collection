{
  "name": "iolab-mcp-collection",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "A collection of remote MCP servers, clustered by research domain and served from one Cloudflare Worker.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "dev:gateway": "pnpm --filter @iolab/gateway run dev",
    "deploy:all": "pnpm -r --if-present run deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
