{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nz-govt-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "NZ_GOVT_MCP", "class_name": "NzGovtMcp" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NzGovtMcp"] }],
  "kv_namespaces": [{ "binding": "MCP_CACHE", "id": "bac29680ac6a419284c9a522b241ae8a" }],
  "routes": [{ "pattern": "nz-govt.mcp.yourdomain.com", "custom_domain": true }],
  "observability": { "enabled": true },
}
