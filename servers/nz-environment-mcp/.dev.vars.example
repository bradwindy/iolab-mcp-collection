# Copy to .dev.vars for local `wrangler dev`. Never commit the real file.
MCP_SHARED_TOKEN=replace-with-a-long-random-string

# Base64-encoded 32-byte AES-256-GCM key used to decrypt upstream API keys stored in
# CREDENTIALS_DB. Generate one with `generateEncryptionKey()` from @nz-mcp/credentials,
# or: node -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))"
ENCRYPTION_KEY=replace-with-a-generated-base64-32-byte-key
