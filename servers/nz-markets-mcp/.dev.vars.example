# Copy to .dev.vars for local `wrangler dev`. Never commit the real file.
MCP_SHARED_TOKEN=replace-with-a-long-random-string

# Base URL of your deployed portal, used only in missing-credential error message links.
PORTAL_URL=https://mcp.example.com

# Base64-encoded 32-byte AES-256-GCM key shared with the portal, used to decrypt
# upstream API keys (NZXplorer / Electricity Authority) stored in CREDENTIALS_DB.
# Generate with generateEncryptionKey() from @nz-mcp/credentials.
ENCRYPTION_KEY=replace-with-a-base64-32-byte-key
