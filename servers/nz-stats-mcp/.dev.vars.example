# Copy to .dev.vars for local `wrangler dev`. Never commit the real file.
MCP_SHARED_TOKEN=replace-with-a-long-random-string

# Base URL of your deployed portal, used only in missing-credential error message links.
PORTAL_URL=https://mcp.example.com

# 32-byte AES-256-GCM key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# or @nz-mcp/credentials' generateEncryptionKey(). Must match the value used by
# the portal when it wrote credentials for this server into the shared D1 database.
ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# NOTE: the actual upstream STATS_NZ_SUBSCRIPTION_KEY is NOT set here. It is stored
# encrypted in the shared nz-mcp-credentials D1 database (server="nz-stats-mcp",
# key_name="STATS_NZ_SUBSCRIPTION_KEY") via the portal, and read per-request with
# getCredential(). See README.md for how to obtain and set it.
