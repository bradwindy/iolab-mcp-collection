# Copy to .dev.vars for local `wrangler dev`. Never commit the real file.
MCP_SHARED_TOKEN=replace-with-a-long-random-string

# 32-byte AES-256-GCM key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be identical across every server that shares the CREDENTIALS_DB, since it
# encrypts/decrypts rows in the same D1 table.
ENCRYPTION_KEY=replace-with-a-base64-32-byte-key
