{
  "name": "@nz-mcp/nz-culture-mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server for NZ digital heritage & museum collections research: DigitalNZ's cross-collection metadata search (no key required) and Te Papa's collections search (requires a Te Papa API key).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@nz-mcp/credentials": "workspace:*",
    "@nz-mcp/mcp-kit": "workspace:*",
    "agents": "^0.17.3",
    "zod": "^4.1.10"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
