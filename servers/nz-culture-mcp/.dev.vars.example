# Copy to .dev.vars for local `wrangler dev`. Never commit the real file.
MCP_SHARED_TOKEN=replace-with-a-long-random-string
# 32-byte AES-256-GCM key, base64-encoded. Generate with @nz-mcp/credentials' generateEncryptionKey(),
# or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
